# Copy to .env and fill in. Never commit the real .env file.
# Use the FRESH, dedicated hackathon paper account's keys here, funded at $100,000.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# Mandatory submission field -- the paper account ID itself (not a secret,
# but keep it here so it lives next to everything else account-related).
ALPACA_PAPER_ACCOUNT_ID=

# --- LLM agent layer (agent/llm_agent.py) -----------------------------------
# Provider-abstracted: set ONE of these two. If both are set, Anthropic wins
# unless you override LLM_PROVIDER explicitly. If neither is set, the system
# still runs -- MarketPlan/postmortem generation degrades to a clearly
# labeled deterministic fallback instead of failing the cycle.

# Option A: Claude, matching the build brief's original "orchestrate through
# Claude" framing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Option B: Featherless (OpenAI-compatible endpoint hosting open-weight
# models). Pick any instruct-tuned model Featherless serves -- note several
# gated models (e.g. meta-llama/Meta-Llama-3.1-70B-Instruct) return a 403
# unless you've connected HuggingFace OAuth for your Featherless account;
# Qwen2.5-72B-Instruct below is ungated and verified working.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Force a specific provider instead of auto-selecting by which key is set:
# LLM_PROVIDER=anthropic | featherless | none
LLM_PROVIDER=

RISK_FREE_RATE=0.045

# Optional: only needed if you enable the CLI-based reads in agent/clients.py
# (the CLI also reads these same two vars, or use `alpaca profile login --api-key`)
